#!/bin/sh
# Register the standalone NVIDIA GPU Monitor and enable DSM's NVIDIA GPU flag.
set -eu
SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME="${SCRIPTDIR%/scripts}/target"
HELPER="$RUNTIME/bin/helper/monitor-helper"
if [ "${1:-}" != "--root" ]; then
    if [ ! -u "$HELPER" ]; then
        echo "nvidia-gpu-monitor: setuid helper not set up correctly ($HELPER)" >&2
        exit 1
    fi
    exec "$HELPER" postinst
fi

MONITOR="/var/packages/syno-nvidia-gpu-monitor/target/bin/syno-nvidia-gpu-monitor"
STATE="/var/packages/syno-nvidia-gpu-monitor/var/ui-backup"
SYNOS="/etc/synoinfo.conf"
SYNODEF="/etc.defaults/synoinfo.conf"

mkdir -p "$STATE"

if [ ! -x "$MONITOR" ] || ! "$MONITOR" --check; then
    echo "A working syno-nvidia-driver NVML runtime is required before installing Synology NVIDIA GPU Monitor." >&2
    exit 1
fi

backup_once() {
    src="$1"; dst="$2"
    [ -e "$dst" ] || cp -p "$src" "$dst"
}

backup_once "$SYNOS" "$STATE/synoinfo.conf"
backup_once "$SYNODEF" "$STATE/synoinfo.defaults.conf"

/usr/syno/bin/synosetkeyvalue "$SYNOS" support_nvidia_gpu yes
/usr/syno/bin/synosetkeyvalue "$SYNODEF" support_nvidia_gpu yes

# Register only this package's standalone WebUI; DSM Resource Monitor assets
# are intentionally left untouched.
mkdir -p /usr/syno/synoman/webman/3rdparty
ln -sfn /var/packages/syno-nvidia-gpu-monitor/target/ui /usr/syno/synoman/webman/3rdparty/SynoNvidiaGpuMonitor

exit 0
